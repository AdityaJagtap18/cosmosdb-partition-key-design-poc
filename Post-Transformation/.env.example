# Azure Cosmos DB (Core/SQL API) credentials — see README below for how to get these.
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# Portal -> your Cosmos DB account -> Settings -> Keys -> URI
COSMOS_URL=https://<your-account-name>.documents.azure.com:443/

# Portal -> your Cosmos DB account -> Settings -> Keys -> PRIMARY KEY
COSMOS_KEY=<your-primary-key>
